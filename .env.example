# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Supabase (service role credentials for the server-side client) ─────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Project Settings → API → service_role secret key. NEVER the anon/public key.
SUPABASE_SERVICE_ROLE_KEY=
# Name of the Storage bucket that holds the startup image (create it as a
# public bucket in Supabase Storage), e.g. "bot-media".
SUPABASE_STORAGE_BUCKET=

# ── Admin authorization ──────────────────────────────────────────────────
# Comma-separated numeric Telegram user IDs. NEVER use usernames here.
ADMIN_TELEGRAM_IDS=

# ── Webhook / server ─────────────────────────────────────────────────────
# Public HTTPS base URL of the deployed app (e.g. https://your-app.up.railway.app).
# The bot appends /telegram/webhook to this when registering the webhook with Telegram.
# Leave empty for local development to fall back to long polling.
WEBHOOK_URL=

# Optional: secret token Telegram will echo back on every webhook request
# (X-Telegram-Bot-Api-Secret-Token header) so the endpoint can reject
# requests that didn't come from Telegram. Recommended in production.
TELEGRAM_WEBHOOK_SECRET=

PORT=3000
